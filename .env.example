# Supabase Session pooler URI (dashboard → Connect → Session pooler).
# Required locally (.env.local) and on Vercel. The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=

# Optional organizer. When both are set, that person can add points adjustments.
# When they are unset, sign up from the app. There is no sample account.
ADMIN_NAME=
ADMIN_PASSWORD=
