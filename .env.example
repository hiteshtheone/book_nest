# Postgres connection string (Supabase: Project Settings → Database → URI).
# When this is unset, the app uses the local file database at data/booknest.sqlite.
DATABASE_URL=

# Optional organizer. When both are set, that person can edit entries and the
# home sample banner is hidden. When either is unset, the sample organizer is used.
ADMIN_NAME=
ADMIN_PASSWORD=
