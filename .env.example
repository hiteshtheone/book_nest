# Postgres connection string (Supabase: Project Settings → Database → URI).
# Required on Vercel. When unset locally, the app uses data/booknest.sqlite.
DATABASE_URL=

# Optional organizer. When both are set, that person can add points adjustments.
# When they are unset, sign up from the app. There is no sample account.
ADMIN_NAME=
ADMIN_PASSWORD=
